{
  "name": "after-sales-desktop",
  "version": "1.0.0",
  "description": "After-Sales Service Management Desktop Application",
  "main": "public/electron.js",
  "homepage": "./",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run electron-dev\" \"npm run react-start\"",
    "dev:local-worker": "concurrently \"npm run worker-dev\" \"npm run electron-dev\" \"npm run react-start\"",
    "react-start": "vite",
    "electron-dev": "wait-on http://localhost:3000 && electron . --dev",
    "worker-dev": "npm --prefix ../worker run dev",
    "build": "npm run react-build && npm run electron-build",
    "react-build": "vite build",
    "electron-build": "electron-builder",
    "test": "echo \"Test not implemented\""
  },
  "dependencies": {
    "axios": "^1.4.0",
    "date-fns": "^2.30.0",
    "firebase": "^12.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^8.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "electron-is-dev": "^3.0.1",
    "vite": "^7.3.1",
    "wait-on": "^7.0.0",
    "wrangler": "^4.61.1"
  },
  "build": {
    "appId": "com.afterpros.desktop",
    "productName": "After-Sales System",
    "files": [
      "src/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "public"
    }
  },
  "proxy": "http://127.0.0.1:8787",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
