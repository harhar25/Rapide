import React, { useState, useEffect, useCallback } from 'react';
import { fetchJson } from '../utils/fetchJson';
import { useAutoRefresh } from '../hooks/useRealtimeUpdates';

const WarehouseDashboard = ({ user, onLogout }) => {
  const [activeTab, setActiveTab] = useState(() => localStorage.getItem('warehouseActiveTab') || 'requests');
  const [products, setProducts] = useState([]);
  const [history, setHistory] = useState([]);
  const [partsRequests, setPartsRequests] = useState([]);
  const [summary, setSummary] = useState(null);
  const [loading, setLoading] = useState(true);
  const [initialLoadDone, setInitialLoadDone] = useState(false);
  const [searchTerm, setSearchTerm] = useState('');
  
  // New state for nice-to-have features
  const [todayActivity, setTodayActivity] = useState({ itemsIn: 0, itemsOut: 0, fulfilled: 0 });
  const [suppliers, setSuppliers] = useState([]);
  const [topRequested, setTopRequested] = useState([]);
  const [pendingStock, setPendingStock] = useState([]);
  const [reportRange, setReportRange] = useState('daily');
  
  // Modals
  const [modal, setModal] = useState(null);
  const [selectedProduct, setSelectedProduct] = useState(null);
  const [message, setMessage] = useState({ type: '', text: '' });

  // Forms
  const [productForm, setProductForm] = useState({
    product_code: '', product_name: '', category: '', unit_price: '',
    quantity_in_stock: '', reorder_level: 10, supplier: '', description: ''
  });
  const [stockForm, setStockForm] = useState({
    product_id: '', quantity: '', action: 'in', reference_no: '', reference_type: 'repair-job', notes: ''
  });
  const [pendingStockForm, setPendingStockForm] = useState({
    product_id: '', quantity: '', po_number: '', supplier: '', expected_date: '', notes: ''
  });
  const [supplierForm, setSupplierForm] = useState({
    name: '', contact_person: '', phone: '', email: '', address: ''
  });

  const API = '/api/warehouse';

  // Styles
  const styles = {
    container: {
      height: '100vh',
      overflow: 'hidden',
      display: 'flex',
      flexDirection: 'column',
      background: '#f8fafc',
      fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif'
    },
    header: {
      background: '#fff',
      borderBottom: '1px solid #e2e8f0',
      padding: '16px 32px',
      display: 'flex',
      justifyContent: 'space-between',
      alignItems: 'center',
      flexShrink: 0
    },
    headerLeft: {
      display: 'flex',
      alignItems: 'center',
      gap: '16px'
    },
    logo: {
      width: '40px',
      height: '40px',
      background: '#0f172a',
      borderRadius: '8px',
      display: 'flex',
      alignItems: 'center',
      justifyContent: 'center',
      color: '#fff',
      fontWeight: '700',
      fontSize: '16px'
    },
    title: {
      fontSize: '18px',
      fontWeight: '600',
      color: '#0f172a',
      margin: 0
    },
    subtitle: {
      fontSize: '12px',
      color: '#64748b',
      margin: 0
    },
    stats: {
      display: 'flex',
      gap: '24px'
    },
    stat: {
      textAlign: 'center'
    },
    statValue: {
      fontSize: '20px',
      fontWeight: '700',
      color: '#0f172a'
    },
    statLabel: {
      fontSize: '10px',
      color: '#64748b',
      textTransform: 'uppercase',
      letterSpacing: '0.5px'
    },
    userSection: {
      display: 'flex',
      alignItems: 'center',
      gap: '12px'
    },
    logoutBtn: {
      padding: '8px 16px',
      background: '#fff',
      border: '1px solid #e2e8f0',
      borderRadius: '6px',
      fontSize: '13px',
      color: '#475569',
      cursor: 'pointer'
    },
    main: {
      display: 'flex',
      flex: 1,
      overflow: 'hidden'
    },
    sidebar: {
      width: '200px',
      background: '#fff',
      borderRight: '1px solid #e2e8f0',
      padding: '16px 0',
      flexShrink: 0,
      overflowY: 'auto'
    },
    navItem: (active) => ({
      display: 'flex',
      alignItems: 'center',
      gap: '10px',
      padding: '10px 20px',
      color: active ? '#0f172a' : '#64748b',
      background: active ? '#f1f5f9' : 'transparent',
      borderLeft: active ? '3px solid #0f172a' : '3px solid transparent',
      fontSize: '13px',
      fontWeight: active ? '600' : '400',
      cursor: 'pointer',
      transition: 'all 0.15s'
    }),
    content: {
      flex: 1,
      padding: '20px 24px',
      overflowY: 'auto',
      height: '100%'
    },
    toolbar: {
      display: 'flex',
      justifyContent: 'space-between',
      alignItems: 'center',
      marginBottom: '16px'
    },
    searchBox: {
      display: 'flex',
      alignItems: 'center',
      gap: '8px',
      background: '#fff',
      border: '1px solid #e2e8f0',
      borderRadius: '6px',
      padding: '8px 12px',
      width: '280px'
    },
    searchInput: {
      border: 'none',
      outline: 'none',
      fontSize: '13px',
      flex: 1,
      color: '#334155'
    },
    btn: (variant) => ({
      padding: '8px 16px',
      borderRadius: '6px',
      fontSize: '13px',
      fontWeight: '500',
      cursor: 'pointer',
      border: 'none',
      transition: 'all 0.15s',
      ...(variant === 'primary' ? { background: '#0f172a', color: '#fff' } :
         variant === 'success' ? { background: '#16a34a', color: '#fff' } :
         variant === 'danger' ? { background: '#dc2626', color: '#fff' } :
         { background: '#f1f5f9', color: '#475569', border: '1px solid #e2e8f0' })
    }),
    card: {
      background: '#fff',
      borderRadius: '8px',
      border: '1px solid #e2e8f0'
    },
    cardHeader: {
      padding: '14px 16px',
      borderBottom: '1px solid #e2e8f0',
      display: 'flex',
      justifyContent: 'space-between',
      alignItems: 'center'
    },
    cardTitle: {
      fontSize: '14px',
      fontWeight: '600',
      color: '#0f172a',
      margin: 0
    },
    table: {
      width: '100%',
      borderCollapse: 'collapse'
    },
    th: {
      padding: '10px 16px',
      textAlign: 'left',
      fontSize: '11px',
      fontWeight: '600',
      color: '#64748b',
      textTransform: 'uppercase',
      letterSpacing: '0.5px',
      background: '#f8fafc',
      borderBottom: '1px solid #e2e8f0'
    },
    td: {
      padding: '12px 16px',
      fontSize: '13px',
      color: '#334155',
      borderBottom: '1px solid #f1f5f9'
    },
    badge: (type) => ({
      display: 'inline-block',
      padding: '3px 8px',
      borderRadius: '4px',
      fontSize: '11px',
      fontWeight: '500',
      background: type === 'success' ? '#dcfce7' : type === 'warning' ? '#fef3c7' : type === 'danger' ? '#fee2e2' : type === 'info' ? '#dbeafe' : '#f1f5f9',
      color: type === 'success' ? '#166534' : type === 'warning' ? '#a16207' : type === 'danger' ? '#dc2626' : type === 'info' ? '#1d4ed8' : '#475569'
    }),
    empty: {
      padding: '40px',
      textAlign: 'center',
      color: '#94a3b8',
      fontSize: '13px'
    },
    modal: {
      position: 'fixed',
      top: 0, left: 0, right: 0, bottom: 0,
      background: 'rgba(15, 23, 42, 0.5)',
      display: 'flex',
      alignItems: 'center',
      justifyContent: 'center',
      zIndex: 1000
    },
    modalContent: {
      background: '#fff',
      borderRadius: '8px',
      width: '480px',
      maxWidth: '90vw',
      maxHeight: '85vh',
      overflow: 'auto'
    },
    modalHeader: {
      padding: '16px 20px',
      borderBottom: '1px solid #e2e8f0',
      display: 'flex',
      justifyContent: 'space-between',
      alignItems: 'center'
    },
    modalTitle: {
      fontSize: '16px',
      fontWeight: '600',
      color: '#0f172a',
      margin: 0
    },
    modalBody: {
      padding: '20px'
    },
    modalFooter: {
      padding: '16px 20px',
      borderTop: '1px solid #e2e8f0',
      display: 'flex',
      justifyContent: 'flex-end',
      gap: '10px'
    },
    formGroup: {
      marginBottom: '14px'
    },
    label: {
      display: 'block',
      fontSize: '12px',
      fontWeight: '500',
      color: '#374151',
      marginBottom: '4px'
    },
    input: {
      width: '100%',
      padding: '8px 12px',
      border: '1px solid #d1d5db',
      borderRadius: '6px',
      fontSize: '13px',
      outline: 'none',
      boxSizing: 'border-box'
    },
    select: {
      width: '100%',
      padding: '8px 12px',
      border: '1px solid #d1d5db',
      borderRadius: '6px',
      fontSize: '13px',
      outline: 'none',
      boxSizing: 'border-box',
      background: '#fff'
    },
    grid2: {
      display: 'grid',
      gridTemplateColumns: '1fr 1fr',
      gap: '12px'
    },
    alert: (type) => ({
      padding: '10px 16px',
      background: type === 'success' ? '#f0fdf4' : '#fef2f2',
      color: type === 'success' ? '#166534' : '#dc2626',
      borderRadius: '6px',
      fontSize: '13px',
      marginBottom: '16px'
    }),
    requestCard: {
      background: '#fff',
      border: '1px solid #e2e8f0',
      borderRadius: '8px',
      marginBottom: '12px',
      overflow: 'hidden'
    },
    requestHeader: {
      padding: '12px 16px',
      background: '#f8fafc',
      borderBottom: '1px solid #e2e8f0',
      display: 'flex',
      justifyContent: 'space-between',
      alignItems: 'center'
    },
    requestBody: {
      padding: '12px 16px'
    },
    itemRow: {
      display: 'flex',
      justifyContent: 'space-between',
      alignItems: 'center',
      padding: '8px 0',
      borderBottom: '1px solid #f1f5f9'
    }
  };

  // Load Data
  useEffect(() => {
    loadAll();
    loadSuppliers();
    loadPendingStock();
    const interval = setInterval(loadAll, 3000); // Refresh every 3s
    return () => clearInterval(interval);
  }, []);

  const handleRealtimeUpdate = useCallback(() => loadAll(), []);
  useAutoRefresh(['warehouse', 'job-controller'], handleRealtimeUpdate);

  const loadAll = async () => {
    if (!initialLoadDone) setLoading(true);
    try {
      const [prodRes, sumRes, reqRes, histRes] = await Promise.all([
        fetchJson(`${API}/products`),
        fetchJson(`${API}/summary`),
        fetchJson('/api/job-controller/parts-requests/pending'),
        fetchJson(`${API}/inventory/history?limit=100`)
      ]);
      if (prodRes.success) setProducts(prodRes.data || []);
      if (sumRes.success) setSummary(sumRes.data);
      if (reqRes.success) setPartsRequests(reqRes.data || []);
      if (histRes.success) {
        setHistory(histRes.data || []);
        calculateTodayActivity(histRes.data || []);
        calculateTopRequested(histRes.data || []);
      }
    } catch (e) {
      console.error('Load error:', e);
    }
    if (!initialLoadDone) {
      setLoading(false);
      setInitialLoadDone(true);
    }
  };

  const loadHistory = async () => {
    try {
      const res = await fetchJson(`${API}/inventory/history?limit=100`);
      if (res.success) {
        setHistory(res.data || []);
        calculateTodayActivity(res.data || []);
        calculateTopRequested(res.data || []);
      }
    } catch (e) {
      console.error('History error:', e);
    }
  };

  // Calculate today's activity from history
  // History tuple format: [id, product_id, product_name, transaction_type, quantity, prev_qty, new_qty, reference_no, reference_type, created_by, notes, created_at]
  const calculateTodayActivity = (historyData) => {
    const today = new Date().toDateString();
    let itemsIn = 0, itemsOut = 0, fulfilled = 0;
    
    historyData.forEach(h => {
      const txDate = new Date(h[11]).toDateString(); // h[11] = created_at
      if (txDate === today) {
        if (h[3] === 'in') itemsIn += parseInt(h[4]) || 0;
        else itemsOut += parseInt(h[4]) || 0;
        if (h[8] === 'repair-job' && h[3] === 'out') fulfilled++;
      }
    });
    
    setTodayActivity({ itemsIn, itemsOut, fulfilled });
  };

  // Calculate top requested items
  const calculateTopRequested = (historyData) => {
    const productCounts = {};
    historyData.forEach(h => {
      if (h[3] === 'out') {
        const productName = h[2];
        productCounts[productName] = (productCounts[productName] || 0) + (parseInt(h[4]) || 0);
      }
    });
    
    const sorted = Object.entries(productCounts)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 10)
      .map(([name, count]) => ({ name, count }));
    
    setTopRequested(sorted);
  };

  // Load suppliers (from products for now, or could be separate table)
  const loadSuppliers = async () => {
    // For now, extract unique suppliers from products
    // In production, this would be a separate API call
    try {
      const res = await fetchJson(`${API}/products`);
      if (res.success) {
        const uniqueSuppliers = [...new Set((res.data || []).map(p => p[7]).filter(Boolean))];
        const supplierList = uniqueSuppliers.map((name, i) => ({
          id: i + 1,
          name,
          contact_person: '-',
          phone: '-',
          email: '-'
        }));
        setSuppliers(supplierList);
      }
    } catch (e) {
      console.error('Suppliers error:', e);
    }
  };

  // Load pending incoming stock (mock for now - would be separate table)
  const loadPendingStock = async () => {
    // This would typically be a separate API endpoint
    // For now, using localStorage as a simple store
    const stored = localStorage.getItem('pendingStock');
    if (stored) setPendingStock(JSON.parse(stored));
  };

  const savePendingStock = (data) => {
    localStorage.setItem('pendingStock', JSON.stringify(data));
    setPendingStock(data);
  };

  const showMessage = (type, text) => {
    setMessage({ type, text });
    setTimeout(() => setMessage({ type: '', text: '' }), 3000);
  };

  // Filter products
  const filteredProducts = products.filter(p => 
    !searchTerm || 
    p[1]?.toLowerCase().includes(searchTerm.toLowerCase()) ||
    p[2]?.toLowerCase().includes(searchTerm.toLowerCase()) ||
    p[3]?.toLowerCase().includes(searchTerm.toLowerCase())
  );

  // Handlers
  const handleAddProduct = async (e) => {
    e.preventDefault();
    try {
      const res = await fetchJson(`${API}/products`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...productForm,
          unit_price: parseFloat(productForm.unit_price) || 0,
          quantity_in_stock: parseInt(productForm.quantity_in_stock) || 0,
          reorder_level: parseInt(productForm.reorder_level) || 10,
          created_by: user?.name
        })
      });
      if (res.success) {
        showMessage('success', 'Product added successfully');
        setModal(null);
        loadAll();
        resetProductForm();
      } else {
        showMessage('error', res.error || 'Failed to add product');
      }
    } catch (e) {
      showMessage('error', e.message);
    }
  };

  const handleUpdateProduct = async (e) => {
    e.preventDefault();
    try {
      const res = await fetchJson(`${API}/products/${selectedProduct[0]}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(productForm)
      });
      if (res.success) {
        showMessage('success', 'Product updated');
        setModal(null);
        loadAll();
      } else {
        showMessage('error', res.error || 'Failed to update');
      }
    } catch (e) {
      showMessage('error', e.message);
    }
  };

  const handleStockTransaction = async (e) => {
    e.preventDefault();
    const endpoint = stockForm.action === 'in' ? '/inventory/add' : '/inventory/remove';
    try {
      const res = await fetchJson(`${API}${endpoint}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          product_id: parseInt(stockForm.product_id),
          quantity: parseInt(stockForm.quantity),
          reference_no: stockForm.reference_no,
          reference_type: stockForm.reference_type,
          notes: stockForm.notes,
          created_by: user?.name
        })
      });
      if (res.success) {
        showMessage('success', `Stock ${stockForm.action === 'in' ? 'added' : 'removed'} successfully`);
        setModal(null);
        loadAll();
        loadHistory();
        resetStockForm();
      } else {
        showMessage('error', res.error || 'Transaction failed');
      }
    } catch (e) {
      showMessage('error', e.message);
    }
  };

  const handleFulfillRequest = async (req) => {
    if (!window.confirm(`Fulfill parts request for ${req.vehicle}?`)) return;
    try {
      // Deduct stock for each item
      for (const item of req.items || []) {
        await fetchJson(`${API}/inventory/remove`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            product_id: item.product_id,
            quantity: item.quantity_requested,
            reference_no: `SO-${req.service_order_id}`,
            reference_type: 'repair-job',
            notes: `${req.vehicle}${req.technician_name ? ` | Tech: ${req.technician_name}` : ''}`,
            created_by: user?.name
          })
        });
      }
      // Update request status
      await fetchJson(`/api/job-controller/parts-requests/${req.id}/fulfill`, { method: 'POST' });
      showMessage('success', 'Parts request fulfilled');
      loadAll();
    } catch (e) {
      showMessage('error', e.message);
    }
  };

  const resetProductForm = () => {
    setProductForm({
      product_code: '', product_name: '', category: '', unit_price: '',
      quantity_in_stock: '', reorder_level: 10, supplier: '', description: ''
    });
  };

  const resetStockForm = () => {
    setStockForm({
      product_id: '', quantity: '', action: 'in', reference_no: '', reference_type: 'repair-job', notes: ''
    });
  };

  const resetPendingStockForm = () => {
    setPendingStockForm({
      product_id: '', quantity: '', po_number: '', supplier: '', expected_date: '', notes: ''
    });
  };

  const resetSupplierForm = () => {
    setSupplierForm({
      name: '', contact_person: '', phone: '', email: '', address: ''
    });
  };

  // Add pending stock
  const handleAddPendingStock = (e) => {
    e.preventDefault();
    const product = products.find(p => p[0] === parseInt(pendingStockForm.product_id));
    const newEntry = {
      id: Date.now(),
      product_id: pendingStockForm.product_id,
      product_name: product ? product[2] : 'Unknown',
      product_code: product ? product[1] : '-',
      quantity: parseInt(pendingStockForm.quantity),
      po_number: pendingStockForm.po_number,
      supplier: pendingStockForm.supplier,
      expected_date: pendingStockForm.expected_date,
      notes: pendingStockForm.notes,
      created_at: new Date().toISOString()
    };
    const updated = [...pendingStock, newEntry];
    savePendingStock(updated);
    showMessage('success', 'Pending stock added');
    setModal(null);
    resetPendingStockForm();
  };

  // Receive pending stock (convert to actual stock)
  const handleReceivePendingStock = async (item) => {
    if (!window.confirm(`Receive ${item.quantity} units of ${item.product_name}?`)) return;
    try {
      const res = await fetchJson(`${API}/inventory/add`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          product_id: parseInt(item.product_id),
          quantity: item.quantity,
          reference_no: item.po_number,
          reference_type: 'purchase',
          notes: `Received from ${item.supplier}`,
          created_by: user?.name
        })
      });
      if (res.success) {
        const updated = pendingStock.filter(p => p.id !== item.id);
        savePendingStock(updated);
        showMessage('success', 'Stock received and added to inventory');
        loadAll();
      }
    } catch (e) {
      showMessage('error', e.message);
    }
  };

  // Add supplier
  const handleAddSupplier = (e) => {
    e.preventDefault();
    const newSupplier = {
      id: Date.now(),
      ...supplierForm
    };
    setSuppliers([...suppliers, newSupplier]);
    showMessage('success', 'Supplier added');
    setModal(null);
    resetSupplierForm();
  };

  // Export report
  const exportReport = () => {
    const data = history.filter(h => {
      const txDate = new Date(h[11]); // h[11] = created_at
      const now = new Date();
      if (reportRange === 'daily') {
        return txDate.toDateString() === now.toDateString();
      } else if (reportRange === 'weekly') {
        const weekAgo = new Date(now - 7 * 24 * 60 * 60 * 1000);
        return txDate >= weekAgo;
      }
      return true;
    });

    const csvContent = [
      ['Date', 'Product', 'Type', 'Quantity', 'Reference', 'Details', 'User'].join(','),
      ...data.map(h => [
        new Date(h[11]).toLocaleString(),
        `"${h[2]}"`, // Quote product name in case it has commas
        h[3] === 'in' ? 'IN' : 'OUT',
        h[4],
        h[7] || '-',
        `"${h[10] || '-'}"`, // h[10] = notes (vehicle/technician)
        h[9] || '-'
      ].join(','))
    ].join('\n');

    const blob = new Blob([csvContent], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `stock-movement-${reportRange}-${new Date().toISOString().split('T')[0]}.csv`;
    a.click();
    URL.revokeObjectURL(url);
    showMessage('success', 'Report exported');
  };

  const openEditProduct = (p) => {
    setSelectedProduct(p);
    setProductForm({
      product_code: p[1], product_name: p[2], category: p[3], unit_price: p[4],
      quantity_in_stock: p[5], reorder_level: p[6], supplier: p[7], description: p[8]
    });
    setModal('edit-product');
  };

  // Filter active parts requests (exclude fulfilled/completed)
  const activePartsRequests = partsRequests.filter(r => r.status !== 'fulfilled' && r.status !== 'completed');

  const tabs = [
    { id: 'requests', label: 'Parts Requests', count: activePartsRequests.length },
    { id: 'dashboard', label: 'Dashboard' },
    { id: 'inventory', label: 'Inventory' },
    { id: 'pending', label: 'Incoming Stock', count: pendingStock.length },
    { id: 'suppliers', label: 'Suppliers' },
    { id: 'reports', label: 'Reports' },
    { id: 'history', label: 'History' },
    { id: 'products', label: 'Products' }
  ];

  return (
    <div style={styles.container}>
      {/* Header */}
      <header style={styles.header}>
        <div style={styles.headerLeft}>
          <div style={styles.logo}>WH</div>
          <div>
            <h1 style={styles.title}>Warehouse</h1>
            <p style={styles.subtitle}>Inventory & Parts Management</p>
          </div>
        </div>

        <div style={styles.stats}>
          <div style={styles.stat}>
            <div style={styles.statValue}>{summary?.total_products || 0}</div>
            <div style={styles.statLabel}>Products</div>
          </div>
          <div style={styles.stat}>
            <div style={styles.statValue}>{summary?.total_quantity || 0}</div>
            <div style={styles.statLabel}>Total Stock</div>
          </div>
          <div style={styles.stat}>
            <div style={{ ...styles.statValue, color: '#16a34a' }}>₱{((summary?.total_value || 0) / 1000).toFixed(0)}K</div>
            <div style={styles.statLabel}>Value</div>
          </div>
          <div style={styles.stat}>
            <div style={{ ...styles.statValue, color: summary?.low_stock_count > 0 ? '#dc2626' : '#16a34a' }}>{summary?.low_stock_count || 0}</div>
            <div style={styles.statLabel}>Low Stock</div>
          </div>
          {partsRequests.length > 0 && (
            <div style={styles.stat}>
              <div style={{ ...styles.statValue, color: '#f59e0b' }}>{partsRequests.length}</div>
              <div style={styles.statLabel}>Pending</div>
            </div>
          )}
        </div>

        <div style={styles.userSection}>
          <span style={{ fontSize: '13px', color: '#64748b' }}>{user?.name || 'Warehouse'}</span>
          <button style={styles.logoutBtn} onClick={onLogout}>Logout</button>
        </div>
      </header>

      {/* Main */}
      <div style={styles.main}>
        {/* Sidebar */}
        <nav style={styles.sidebar}>
          {tabs.map(tab => (
            <div 
              key={tab.id} 
              style={styles.navItem(activeTab === tab.id)}
              onClick={() => {
                setActiveTab(tab.id);
                localStorage.setItem('warehouseActiveTab', tab.id);
                if (tab.id === 'history') loadHistory();
              }}
            >
              <span>{tab.label}</span>
              {tab.count > 0 && (
                <span style={{
                  marginLeft: 'auto',
                  background: '#f59e0b',
                  color: '#fff',
                  fontSize: '10px',
                  padding: '2px 6px',
                  borderRadius: '10px',
                  fontWeight: '600'
                }}>{tab.count}</span>
              )}
            </div>
          ))}
        </nav>

        {/* Content */}
        <main style={styles.content}>
          {message.text && <div style={styles.alert(message.type)}>{message.text}</div>}

          {/* Parts Requests Tab */}
          {activeTab === 'requests' && (
            <div>
              <div style={styles.toolbar}>
                <h2 style={{ margin: 0, fontSize: '16px', fontWeight: '600', color: '#0f172a' }}>
                  Parts Requests ({activePartsRequests.length})
                </h2>
                <button style={styles.btn()} onClick={loadAll}>Refresh</button>
              </div>

              {activePartsRequests.length === 0 ? (
                <div style={styles.card}>
                  <div style={styles.empty}>
                    No pending parts requests
                  </div>
                </div>
              ) : (
                activePartsRequests.map(req => (
                  <div key={req.id} style={styles.requestCard}>
                    <div style={styles.requestHeader}>
                      <div>
                        <div style={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '4px' }}>
                          <span style={{ fontWeight: '600', color: '#0f172a', fontSize: '14px' }}>SO #{req.service_order_id}</span>
                          <span style={styles.badge(req.status === 'pending' ? 'warning' : 'info')}>
                            {req.status === 'pending' ? 'Awaiting Approval' : req.status}
                          </span>
                        </div>
                        <div style={{ fontSize: '12px', color: '#64748b' }}>
                          <strong>{req.technician_name || 'Unknown Technician'}</strong> • {req.vehicle} • {req.service_type}
                        </div>
                      </div>
                      <div style={{ textAlign: 'right' }}>
                        <div style={{ fontSize: '11px', color: '#94a3b8' }}>
                          {new Date(req.created_at).toLocaleString()}
                        </div>
                      </div>
                    </div>
                    <div style={styles.requestBody}>
                      <div style={{ fontSize: '11px', color: '#64748b', textTransform: 'uppercase', letterSpacing: '0.5px', marginBottom: '8px' }}>
                        Items Requested
                      </div>
                      {(req.items || []).map((item, idx) => {
                        const product = products.find(p => p[0] === item.product_id);
                        const inStock = product ? product[5] : 0;
                        const canFulfill = inStock >= item.quantity_requested;
                        return (
                          <div key={idx} style={styles.itemRow}>
                            <div>
                              <span style={{ fontWeight: '500', color: '#1e293b' }}>{item.product_name || item.product_code}</span>
                              <span style={{ marginLeft: '8px', color: '#64748b', fontSize: '12px' }}>×{item.quantity_requested}</span>
                            </div>
                            <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
                              <span style={{ fontSize: '12px', color: canFulfill ? '#16a34a' : '#dc2626' }}>
                                Stock: {inStock}
                              </span>
                              {!canFulfill && <span style={styles.badge('danger')}>Low</span>}
                            </div>
                          </div>
                        );
                      })}
                      <div style={{ marginTop: '12px', display: 'flex', gap: '8px', justifyContent: 'flex-end' }}>
                        {req.status === 'sent-to-warehouse' && (
                          <button 
                            style={styles.btn('success')} 
                            onClick={() => handleFulfillRequest(req)}
                          >
                            Fulfill & Deduct Stock
                          </button>
                        )}
                        {req.status === 'pending' && (
                          <span style={{ fontSize: '12px', color: '#f59e0b', fontStyle: 'italic' }}>
                            Waiting for Job Controller approval
                          </span>
                        )}
                      </div>
                    </div>
                  </div>
                ))
              )}
            </div>
          )}

          {/* Inventory Tab */}
          {activeTab === 'inventory' && (
            <div>
              <div style={styles.toolbar}>
                <div style={styles.searchBox}>
                  <input
                    style={styles.searchInput}
                    type="text"
                    placeholder="Search inventory..."
                    value={searchTerm}
                    onChange={(e) => setSearchTerm(e.target.value)}
                  />
                </div>
                <div style={{ display: 'flex', gap: '8px' }}>
                  <button style={styles.btn('success')} onClick={() => { resetStockForm(); setStockForm(f => ({ ...f, action: 'in' })); setModal('stock'); }}>
                    Stock In
                  </button>
                  <button style={styles.btn('danger')} onClick={() => { resetStockForm(); setStockForm(f => ({ ...f, action: 'out' })); setModal('stock'); }}>
                    Stock Out
                  </button>
                </div>
              </div>

              <div style={styles.card}>
                <table style={styles.table}>
                  <thead>
                    <tr>
                      <th style={styles.th}>Code</th>
                      <th style={styles.th}>Product</th>
                      <th style={styles.th}>Category</th>
                      <th style={styles.th}>Price</th>
                      <th style={styles.th}>Stock</th>
                      <th style={styles.th}>Reorder</th>
                      <th style={styles.th}>Status</th>
                      <th style={styles.th}>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    {filteredProducts.length === 0 ? (
                      <tr><td colSpan="8" style={styles.empty}>No products found</td></tr>
                    ) : (
                      filteredProducts.map(p => (
                        <tr key={p[0]}>
                          <td style={styles.td}><strong>{p[1]}</strong></td>
                          <td style={styles.td}>{p[2]}</td>
                          <td style={styles.td}>{p[3]}</td>
                          <td style={styles.td}>₱{parseFloat(p[4]).toLocaleString()}</td>
                          <td style={{ ...styles.td, fontWeight: '600', color: p[5] <= p[6] ? '#dc2626' : '#0f172a' }}>{p[5]}</td>
                          <td style={styles.td}>{p[6]}</td>
                          <td style={styles.td}>
                            <span style={styles.badge(p[5] <= p[6] ? 'danger' : p[5] <= p[6] * 2 ? 'warning' : 'success')}>
                              {p[5] <= p[6] ? 'Low' : p[5] <= p[6] * 2 ? 'Medium' : 'OK'}
                            </span>
                          </td>
                          <td style={styles.td}>
                            <button style={styles.btn()} onClick={() => openEditProduct(p)}>Edit</button>
                          </td>
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {/* Dashboard Tab - Today's Activity Summary */}
          {activeTab === 'dashboard' && (
            <div>
              <div style={styles.toolbar}>
                <h2 style={{ margin: 0, fontSize: '16px', fontWeight: '600', color: '#0f172a' }}>Today's Activity</h2>
                <button style={styles.btn()} onClick={loadAll}>Refresh</button>
              </div>

              {/* Today's Stats */}
              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: '16px', marginBottom: '20px' }}>
                <div style={{ ...styles.card, padding: '16px' }}>
                  <div style={{ fontSize: '24px', fontWeight: '700', color: '#16a34a' }}>{todayActivity.itemsIn}</div>
                  <div style={{ fontSize: '12px', color: '#64748b' }}>Items In Today</div>
                </div>
                <div style={{ ...styles.card, padding: '16px' }}>
                  <div style={{ fontSize: '24px', fontWeight: '700', color: '#dc2626' }}>{todayActivity.itemsOut}</div>
                  <div style={{ fontSize: '12px', color: '#64748b' }}>Items Out Today</div>
                </div>
                <div style={{ ...styles.card, padding: '16px' }}>
                  <div style={{ fontSize: '24px', fontWeight: '700', color: '#1d4ed8' }}>{todayActivity.fulfilled}</div>
                  <div style={{ fontSize: '12px', color: '#64748b' }}>Requests Fulfilled</div>
                </div>
                <div style={{ ...styles.card, padding: '16px' }}>
                  <div style={{ fontSize: '24px', fontWeight: '700', color: '#f59e0b' }}>{pendingStock.length}</div>
                  <div style={{ fontSize: '12px', color: '#64748b' }}>Pending Deliveries</div>
                </div>
              </div>

              {/* Two Column Layout */}
              <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '16px' }}>
                {/* Top Requested Items */}
                <div style={styles.card}>
                  <div style={styles.cardHeader}>
                    <h3 style={styles.cardTitle}>Top Requested Items</h3>
                  </div>
                  <div style={{ padding: '12px' }}>
                    {topRequested.length === 0 ? (
                      <div style={styles.empty}>No data yet</div>
                    ) : (
                      topRequested.map((item, idx) => (
                        <div key={idx} style={{ display: 'flex', justifyContent: 'space-between', padding: '8px 4px', borderBottom: '1px solid #f1f5f9' }}>
                          <span style={{ fontSize: '13px', color: '#334155' }}>{idx + 1}. {item.name}</span>
                          <span style={{ fontSize: '13px', fontWeight: '600', color: '#0f172a' }}>{item.count} units</span>
                        </div>
                      ))
                    )}
                  </div>
                </div>

                {/* Low Stock Alerts */}
                <div style={styles.card}>
                  <div style={styles.cardHeader}>
                    <h3 style={styles.cardTitle}>Low Stock Alerts</h3>
                  </div>
                  <div style={{ padding: '12px' }}>
                    {products.filter(p => p[5] <= p[6]).length === 0 ? (
                      <div style={styles.empty}>All stock levels OK</div>
                    ) : (
                      products.filter(p => p[5] <= p[6]).slice(0, 10).map((p, idx) => (
                        <div key={idx} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', padding: '8px 4px', borderBottom: '1px solid #f1f5f9' }}>
                          <div>
                            <div style={{ fontSize: '13px', fontWeight: '500', color: '#334155' }}>{p[2]}</div>
                            <div style={{ fontSize: '11px', color: '#94a3b8' }}>{p[1]}</div>
                          </div>
                          <div style={{ textAlign: 'right' }}>
                            <span style={styles.badge('danger')}>{p[5]} left</span>
                            <div style={{ fontSize: '10px', color: '#94a3b8', marginTop: '2px' }}>Reorder: {p[6]}</div>
                          </div>
                        </div>
                      ))
                    )}
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* History Tab */}
          {activeTab === 'history' && (
            <div>
              <div style={styles.toolbar}>
                <h2 style={{ margin: 0, fontSize: '16px', fontWeight: '600', color: '#0f172a' }}>Transaction History</h2>
                <button style={styles.btn()} onClick={loadHistory}>Refresh</button>
              </div>

              <div style={styles.card}>
                <table style={styles.table}>
                  <thead>
                    <tr>
                      <th style={styles.th}>Date</th>
                      <th style={styles.th}>Product</th>
                      <th style={styles.th}>Type</th>
                      <th style={styles.th}>Qty</th>
                      <th style={styles.th}>Reference</th>
                      <th style={styles.th}>Details</th>
                      <th style={styles.th}>User</th>
                    </tr>
                  </thead>
                  <tbody>
                    {history.length === 0 ? (
                      <tr><td colSpan="7" style={styles.empty}>No transactions yet</td></tr>
                    ) : (
                      history.map((h, i) => (
                        <tr key={i}>
                          <td style={styles.td}>{new Date(h[11]).toLocaleString()}</td>
                          <td style={styles.td}><strong>{h[2]}</strong></td>
                          <td style={styles.td}>
                            <span style={styles.badge(h[3] === 'in' ? 'success' : 'danger')}>
                              {h[3] === 'in' ? '+ IN' : '− OUT'}
                            </span>
                          </td>
                          <td style={styles.td}>{h[4]}</td>
                          <td style={styles.td}>{h[7] || '-'}</td>
                          <td style={styles.td}>{h[10] || '-'}</td>
                          <td style={styles.td}>{h[9] || '-'}</td>
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {/* Pending Incoming Stock Tab */}
          {activeTab === 'pending' && (
            <div>
              <div style={styles.toolbar}>
                <h2 style={{ margin: 0, fontSize: '16px', fontWeight: '600', color: '#0f172a' }}>Pending Incoming Stock ({pendingStock.length})</h2>
                <button style={styles.btn('primary')} onClick={() => { resetPendingStockForm(); setModal('add-pending'); }}>
                  Add Expected Delivery
                </button>
              </div>

              <div style={styles.card}>
                <table style={styles.table}>
                  <thead>
                    <tr>
                      <th style={styles.th}>PO Number</th>
                      <th style={styles.th}>Product</th>
                      <th style={styles.th}>Quantity</th>
                      <th style={styles.th}>Supplier</th>
                      <th style={styles.th}>Expected Date</th>
                      <th style={styles.th}>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    {pendingStock.length === 0 ? (
                      <tr><td colSpan="6" style={styles.empty}>No pending deliveries</td></tr>
                    ) : (
                      pendingStock.map((item) => (
                        <tr key={item.id}>
                          <td style={styles.td}><strong>{item.po_number || '-'}</strong></td>
                          <td style={styles.td}>{item.product_name} ({item.product_code})</td>
                          <td style={styles.td}>{item.quantity}</td>
                          <td style={styles.td}>{item.supplier || '-'}</td>
                          <td style={styles.td}>{item.expected_date ? new Date(item.expected_date).toLocaleDateString() : '-'}</td>
                          <td style={styles.td}>
                            <div style={{ display: 'flex', gap: '6px' }}>
                              <button style={styles.btn('success')} onClick={() => handleReceivePendingStock(item)}>Receive</button>
                              <button style={styles.btn('danger')} onClick={() => {
                                if (window.confirm('Cancel this pending delivery?')) {
                                  const updated = pendingStock.filter(p => p.id !== item.id);
                                  savePendingStock(updated);
                                }
                              }}>Cancel</button>
                            </div>
                          </td>
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {/* Suppliers Tab */}
          {activeTab === 'suppliers' && (
            <div>
              <div style={styles.toolbar}>
                <h2 style={{ margin: 0, fontSize: '16px', fontWeight: '600', color: '#0f172a' }}>Suppliers ({suppliers.length})</h2>
                <button style={styles.btn('primary')} onClick={() => { resetSupplierForm(); setModal('add-supplier'); }}>
                  Add Supplier
                </button>
              </div>

              <div style={styles.card}>
                <table style={styles.table}>
                  <thead>
                    <tr>
                      <th style={styles.th}>Supplier Name</th>
                      <th style={styles.th}>Contact Person</th>
                      <th style={styles.th}>Phone</th>
                      <th style={styles.th}>Email</th>
                      <th style={styles.th}>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    {suppliers.length === 0 ? (
                      <tr><td colSpan="5" style={styles.empty}>No suppliers yet</td></tr>
                    ) : (
                      suppliers.map((s) => (
                        <tr key={s.id}>
                          <td style={styles.td}><strong>{s.name}</strong></td>
                          <td style={styles.td}>{s.contact_person || '-'}</td>
                          <td style={styles.td}>{s.phone || '-'}</td>
                          <td style={styles.td}>{s.email || '-'}</td>
                          <td style={styles.td}>
                            {s.phone && s.phone !== '-' && (
                              <button style={styles.btn()} onClick={() => window.open(`tel:${s.phone}`)}>Call</button>
                            )}
                          </td>
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {/* Reports Tab */}
          {activeTab === 'reports' && (
            <div>
              <div style={styles.toolbar}>
                <h2 style={{ margin: 0, fontSize: '16px', fontWeight: '600', color: '#0f172a' }}>Stock Movement Report</h2>
                <div style={{ display: 'flex', gap: '8px', alignItems: 'center' }}>
                  <select style={{ ...styles.select, width: '120px' }} value={reportRange} onChange={(e) => setReportRange(e.target.value)}>
                    <option value="daily">Daily</option>
                    <option value="weekly">Weekly</option>
                  </select>
                  <button style={styles.btn('primary')} onClick={exportReport}>Export CSV</button>
                </div>
              </div>

              {/* Report Summary */}
              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: '16px', marginBottom: '20px' }}>
                <div style={{ ...styles.card, padding: '16px' }}>
                  <div style={{ fontSize: '20px', fontWeight: '700', color: '#16a34a' }}>
                    {history.filter(h => {
                      const txDate = new Date(h[11]);
                      const now = new Date();
                      if (reportRange === 'daily') return txDate.toDateString() === now.toDateString();
                      const weekAgo = new Date(now - 7 * 24 * 60 * 60 * 1000);
                      return txDate >= weekAgo;
                    }).filter(h => h[3] === 'in').reduce((sum, h) => sum + (parseInt(h[4]) || 0), 0)}
                  </div>
                  <div style={{ fontSize: '12px', color: '#64748b' }}>Total Items In ({reportRange})</div>
                </div>
                <div style={{ ...styles.card, padding: '16px' }}>
                  <div style={{ fontSize: '20px', fontWeight: '700', color: '#dc2626' }}>
                    {history.filter(h => {
                      const txDate = new Date(h[11]);
                      const now = new Date();
                      if (reportRange === 'daily') return txDate.toDateString() === now.toDateString();
                      const weekAgo = new Date(now - 7 * 24 * 60 * 60 * 1000);
                      return txDate >= weekAgo;
                    }).filter(h => h[3] === 'out').reduce((sum, h) => sum + (parseInt(h[4]) || 0), 0)}
                  </div>
                  <div style={{ fontSize: '12px', color: '#64748b' }}>Total Items Out ({reportRange})</div>
                </div>
                <div style={{ ...styles.card, padding: '16px' }}>
                  <div style={{ fontSize: '20px', fontWeight: '700', color: '#0f172a' }}>
                    {history.filter(h => {
                      const txDate = new Date(h[11]);
                      const now = new Date();
                      if (reportRange === 'daily') return txDate.toDateString() === now.toDateString();
                      const weekAgo = new Date(now - 7 * 24 * 60 * 60 * 1000);
                      return txDate >= weekAgo;
                    }).length}
                  </div>
                  <div style={{ fontSize: '12px', color: '#64748b' }}>Total Transactions ({reportRange})</div>
                </div>
              </div>

              <div style={styles.card}>
                <div style={styles.cardHeader}>
                  <h3 style={styles.cardTitle}>{reportRange === 'daily' ? "Today's" : "This Week's"} Movements</h3>
                </div>
                <table style={styles.table}>
                  <thead>
                    <tr>
                      <th style={styles.th}>Date</th>
                      <th style={styles.th}>Product</th>
                      <th style={styles.th}>Type</th>
                      <th style={styles.th}>Qty</th>
                      <th style={styles.th}>Reference</th>
                      <th style={styles.th}>Details</th>
                    </tr>
                  </thead>
                  <tbody>
                    {history.filter(h => {
                      const txDate = new Date(h[11]);
                      const now = new Date();
                      if (reportRange === 'daily') return txDate.toDateString() === now.toDateString();
                      const weekAgo = new Date(now - 7 * 24 * 60 * 60 * 1000);
                      return txDate >= weekAgo;
                    }).length === 0 ? (
                      <tr><td colSpan="6" style={styles.empty}>No movements in this period</td></tr>
                    ) : (
                      history.filter(h => {
                        const txDate = new Date(h[11]);
                        const now = new Date();
                        if (reportRange === 'daily') return txDate.toDateString() === now.toDateString();
                        const weekAgo = new Date(now - 7 * 24 * 60 * 60 * 1000);
                        return txDate >= weekAgo;
                      }).map((h, i) => (
                        <tr key={i}>
                          <td style={styles.td}>{new Date(h[11]).toLocaleString()}</td>
                          <td style={styles.td}><strong>{h[2]}</strong></td>
                          <td style={styles.td}>
                            <span style={styles.badge(h[3] === 'in' ? 'success' : 'danger')}>
                              {h[3] === 'in' ? 'IN' : 'OUT'}
                            </span>
                          </td>
                          <td style={styles.td}>{h[4]}</td>
                          <td style={styles.td}>{h[7] || '-'}</td>
                          <td style={styles.td}>{h[10] || '-'}</td>
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {/* Products Tab */}
          {activeTab === 'products' && (
            <div>
              <div style={styles.toolbar}>
                <div style={styles.searchBox}>
                  <input
                    style={styles.searchInput}
                    type="text"
                    placeholder="Search products..."
                    value={searchTerm}
                    onChange={(e) => setSearchTerm(e.target.value)}
                  />
                </div>
                <button style={styles.btn('primary')} onClick={() => { resetProductForm(); setModal('add-product'); }}>
                  Add Product
                </button>
              </div>

              <div style={styles.card}>
                <table style={styles.table}>
                  <thead>
                    <tr>
                      <th style={styles.th}>Code</th>
                      <th style={styles.th}>Product Name</th>
                      <th style={styles.th}>Category</th>
                      <th style={styles.th}>Price</th>
                      <th style={styles.th}>Supplier</th>
                      <th style={styles.th}>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    {filteredProducts.map(p => (
                      <tr key={p[0]}>
                        <td style={styles.td}><strong>{p[1]}</strong></td>
                        <td style={styles.td}>{p[2]}</td>
                        <td style={styles.td}>{p[3]}</td>
                        <td style={styles.td}>₱{parseFloat(p[4]).toLocaleString()}</td>
                        <td style={styles.td}>{p[7] || '-'}</td>
                        <td style={styles.td}>
                          <button style={styles.btn()} onClick={() => openEditProduct(p)}>Edit</button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </main>
      </div>

      {/* Stock Modal */}
      {modal === 'stock' && (
        <div style={styles.modal}>
          <div style={styles.modalContent}>
            <div style={styles.modalHeader}>
              <h3 style={styles.modalTitle}>{stockForm.action === 'in' ? 'Stock In' : 'Stock Out'}</h3>
              <button onClick={() => setModal(null)} style={{ background: 'none', border: 'none', fontSize: '18px', cursor: 'pointer', color: '#64748b' }}>×</button>
            </div>
            <form onSubmit={handleStockTransaction}>
              <div style={styles.modalBody}>
                <div style={styles.formGroup}>
                  <label style={styles.label}>Product *</label>
                  <select style={styles.select} value={stockForm.product_id} onChange={(e) => setStockForm({ ...stockForm, product_id: e.target.value })} required>
                    <option value="">Select product...</option>
                    {products.map(p => (
                      <option key={p[0]} value={p[0]}>{p[2]} ({p[1]}) - Stock: {p[5]}</option>
                    ))}
                  </select>
                </div>
                <div style={styles.grid2}>
                  <div style={styles.formGroup}>
                    <label style={styles.label}>Quantity *</label>
                    <input style={styles.input} type="number" min="1" value={stockForm.quantity} onChange={(e) => setStockForm({ ...stockForm, quantity: e.target.value })} required />
                  </div>
                  <div style={styles.formGroup}>
                    <label style={styles.label}>Reference No</label>
                    <input style={styles.input} type="text" value={stockForm.reference_no} onChange={(e) => setStockForm({ ...stockForm, reference_no: e.target.value })} />
                  </div>
                </div>
                <div style={styles.formGroup}>
                  <label style={styles.label}>Reference Type</label>
                  <select style={styles.select} value={stockForm.reference_type} onChange={(e) => setStockForm({ ...stockForm, reference_type: e.target.value })}>
                    <option value="repair-job">Repair Job</option>
                    <option value="purchase">Purchase</option>
                    <option value="sale">Sale</option>
                    <option value="adjustment">Adjustment</option>
                    <option value="damage">Damage</option>
                  </select>
                </div>
                <div style={styles.formGroup}>
                  <label style={styles.label}>Notes</label>
                  <input style={styles.input} type="text" value={stockForm.notes} onChange={(e) => setStockForm({ ...stockForm, notes: e.target.value })} />
                </div>
              </div>
              <div style={styles.modalFooter}>
                <button type="button" style={styles.btn()} onClick={() => setModal(null)}>Cancel</button>
                <button type="submit" style={styles.btn(stockForm.action === 'in' ? 'success' : 'danger')}>
                  {stockForm.action === 'in' ? 'Add Stock' : 'Remove Stock'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Add Product Modal */}
      {modal === 'add-product' && (
        <div style={styles.modal}>
          <div style={styles.modalContent}>
            <div style={styles.modalHeader}>
              <h3 style={styles.modalTitle}>Add New Product</h3>
              <button onClick={() => setModal(null)} style={{ background: 'none', border: 'none', fontSize: '18px', cursor: 'pointer', color: '#64748b' }}>×</button>
            </div>
            <form onSubmit={handleAddProduct}>
              <div style={styles.modalBody}>
                <div style={styles.grid2}>
                  <div style={styles.formGroup}>
                    <label style={styles.label}>Product Code *</label>
                    <input style={styles.input} type="text" value={productForm.product_code} onChange={(e) => setProductForm({ ...productForm, product_code: e.target.value })} required />
                  </div>
                  <div style={styles.formGroup}>
                    <label style={styles.label}>Product Name *</label>
                    <input style={styles.input} type="text" value={productForm.product_name} onChange={(e) => setProductForm({ ...productForm, product_name: e.target.value })} required />
                  </div>
                </div>
                <div style={styles.grid2}>
                  <div style={styles.formGroup}>
                    <label style={styles.label}>Category *</label>
                    <input style={styles.input} type="text" value={productForm.category} onChange={(e) => setProductForm({ ...productForm, category: e.target.value })} required />
                  </div>
                  <div style={styles.formGroup}>
                    <label style={styles.label}>Unit Price *</label>
                    <input style={styles.input} type="number" step="0.01" value={productForm.unit_price} onChange={(e) => setProductForm({ ...productForm, unit_price: e.target.value })} required />
                  </div>
                </div>
                <div style={styles.grid2}>
                  <div style={styles.formGroup}>
                    <label style={styles.label}>Initial Stock</label>
                    <input style={styles.input} type="number" min="0" value={productForm.quantity_in_stock} onChange={(e) => setProductForm({ ...productForm, quantity_in_stock: e.target.value })} />
                  </div>
                  <div style={styles.formGroup}>
                    <label style={styles.label}>Reorder Level</label>
                    <input style={styles.input} type="number" min="0" value={productForm.reorder_level} onChange={(e) => setProductForm({ ...productForm, reorder_level: e.target.value })} />
                  </div>
                </div>
                <div style={styles.formGroup}>
                  <label style={styles.label}>Supplier</label>
                  <input style={styles.input} type="text" value={productForm.supplier} onChange={(e) => setProductForm({ ...productForm, supplier: e.target.value })} />
                </div>
                <div style={styles.formGroup}>
                  <label style={styles.label}>Description</label>
                  <input style={styles.input} type="text" value={productForm.description} onChange={(e) => setProductForm({ ...productForm, description: e.target.value })} />
                </div>
              </div>
              <div style={styles.modalFooter}>
                <button type="button" style={styles.btn()} onClick={() => setModal(null)}>Cancel</button>
                <button type="submit" style={styles.btn('primary')}>Save Product</button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Edit Product Modal */}
      {modal === 'edit-product' && (
        <div style={styles.modal}>
          <div style={styles.modalContent}>
            <div style={styles.modalHeader}>
              <h3 style={styles.modalTitle}>Edit Product</h3>
              <button onClick={() => setModal(null)} style={{ background: 'none', border: 'none', fontSize: '18px', cursor: 'pointer', color: '#64748b' }}>×</button>
            </div>
            <form onSubmit={handleUpdateProduct}>
              <div style={styles.modalBody}>
                <div style={styles.grid2}>
                  <div style={styles.formGroup}>
                    <label style={styles.label}>Product Code</label>
                    <input style={styles.input} type="text" value={productForm.product_code} onChange={(e) => setProductForm({ ...productForm, product_code: e.target.value })} required />
                  </div>
                  <div style={styles.formGroup}>
                    <label style={styles.label}>Product Name</label>
                    <input style={styles.input} type="text" value={productForm.product_name} onChange={(e) => setProductForm({ ...productForm, product_name: e.target.value })} required />
                  </div>
                </div>
                <div style={styles.grid2}>
                  <div style={styles.formGroup}>
                    <label style={styles.label}>Category</label>
                    <input style={styles.input} type="text" value={productForm.category} onChange={(e) => setProductForm({ ...productForm, category: e.target.value })} required />
                  </div>
                  <div style={styles.formGroup}>
                    <label style={styles.label}>Unit Price</label>
                    <input style={styles.input} type="number" step="0.01" value={productForm.unit_price} onChange={(e) => setProductForm({ ...productForm, unit_price: e.target.value })} required />
                  </div>
                </div>
                <div style={styles.formGroup}>
                  <label style={styles.label}>Reorder Level</label>
                  <input style={styles.input} type="number" min="0" value={productForm.reorder_level} onChange={(e) => setProductForm({ ...productForm, reorder_level: e.target.value })} />
                </div>
                <div style={styles.formGroup}>
                  <label style={styles.label}>Supplier</label>
                  <input style={styles.input} type="text" value={productForm.supplier} onChange={(e) => setProductForm({ ...productForm, supplier: e.target.value })} />
                </div>
                <div style={styles.formGroup}>
                  <label style={styles.label}>Description</label>
                  <input style={styles.input} type="text" value={productForm.description} onChange={(e) => setProductForm({ ...productForm, description: e.target.value })} />
                </div>
              </div>
              <div style={styles.modalFooter}>
                <button type="button" style={styles.btn()} onClick={() => setModal(null)}>Cancel</button>
                <button type="submit" style={styles.btn('primary')}>Update Product</button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Add Pending Stock Modal */}
      {modal === 'add-pending' && (
        <div style={styles.modal}>
          <div style={styles.modalContent}>
            <div style={styles.modalHeader}>
              <h3 style={styles.modalTitle}>Add Expected Delivery</h3>
              <button onClick={() => setModal(null)} style={{ background: 'none', border: 'none', fontSize: '18px', cursor: 'pointer', color: '#64748b' }}>×</button>
            </div>
            <form onSubmit={handleAddPendingStock}>
              <div style={styles.modalBody}>
                <div style={styles.formGroup}>
                  <label style={styles.label}>Product *</label>
                  <select style={styles.select} value={pendingStockForm.product_id} onChange={(e) => setPendingStockForm({ ...pendingStockForm, product_id: e.target.value })} required>
                    <option value="">Select product...</option>
                    {products.map(p => (
                      <option key={p[0]} value={p[0]}>{p[2]} ({p[1]})</option>
                    ))}
                  </select>
                </div>
                <div style={styles.grid2}>
                  <div style={styles.formGroup}>
                    <label style={styles.label}>Quantity *</label>
                    <input style={styles.input} type="number" min="1" value={pendingStockForm.quantity} onChange={(e) => setPendingStockForm({ ...pendingStockForm, quantity: e.target.value })} required />
                  </div>
                  <div style={styles.formGroup}>
                    <label style={styles.label}>PO Number</label>
                    <input style={styles.input} type="text" value={pendingStockForm.po_number} onChange={(e) => setPendingStockForm({ ...pendingStockForm, po_number: e.target.value })} />
                  </div>
                </div>
                <div style={styles.grid2}>
                  <div style={styles.formGroup}>
                    <label style={styles.label}>Supplier</label>
                    <input style={styles.input} type="text" value={pendingStockForm.supplier} onChange={(e) => setPendingStockForm({ ...pendingStockForm, supplier: e.target.value })} list="suppliers-list" />
                    <datalist id="suppliers-list">
                      {suppliers.map(s => <option key={s.id} value={s.name} />)}
                    </datalist>
                  </div>
                  <div style={styles.formGroup}>
                    <label style={styles.label}>Expected Date</label>
                    <input style={styles.input} type="date" value={pendingStockForm.expected_date} onChange={(e) => setPendingStockForm({ ...pendingStockForm, expected_date: e.target.value })} />
                  </div>
                </div>
                <div style={styles.formGroup}>
                  <label style={styles.label}>Notes</label>
                  <input style={styles.input} type="text" value={pendingStockForm.notes} onChange={(e) => setPendingStockForm({ ...pendingStockForm, notes: e.target.value })} />
                </div>
              </div>
              <div style={styles.modalFooter}>
                <button type="button" style={styles.btn()} onClick={() => setModal(null)}>Cancel</button>
                <button type="submit" style={styles.btn('primary')}>Add Delivery</button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Add Supplier Modal */}
      {modal === 'add-supplier' && (
        <div style={styles.modal}>
          <div style={styles.modalContent}>
            <div style={styles.modalHeader}>
              <h3 style={styles.modalTitle}>Add Supplier</h3>
              <button onClick={() => setModal(null)} style={{ background: 'none', border: 'none', fontSize: '18px', cursor: 'pointer', color: '#64748b' }}>×</button>
            </div>
            <form onSubmit={handleAddSupplier}>
              <div style={styles.modalBody}>
                <div style={styles.formGroup}>
                  <label style={styles.label}>Supplier Name *</label>
                  <input style={styles.input} type="text" value={supplierForm.name} onChange={(e) => setSupplierForm({ ...supplierForm, name: e.target.value })} required />
                </div>
                <div style={styles.grid2}>
                  <div style={styles.formGroup}>
                    <label style={styles.label}>Contact Person</label>
                    <input style={styles.input} type="text" value={supplierForm.contact_person} onChange={(e) => setSupplierForm({ ...supplierForm, contact_person: e.target.value })} />
                  </div>
                  <div style={styles.formGroup}>
                    <label style={styles.label}>Phone</label>
                    <input style={styles.input} type="text" value={supplierForm.phone} onChange={(e) => setSupplierForm({ ...supplierForm, phone: e.target.value })} />
                  </div>
                </div>
                <div style={styles.formGroup}>
                  <label style={styles.label}>Email</label>
                  <input style={styles.input} type="email" value={supplierForm.email} onChange={(e) => setSupplierForm({ ...supplierForm, email: e.target.value })} />
                </div>
                <div style={styles.formGroup}>
                  <label style={styles.label}>Address</label>
                  <input style={styles.input} type="text" value={supplierForm.address} onChange={(e) => setSupplierForm({ ...supplierForm, address: e.target.value })} />
                </div>
              </div>
              <div style={styles.modalFooter}>
                <button type="button" style={styles.btn()} onClick={() => setModal(null)}>Cancel</button>
                <button type="submit" style={styles.btn('primary')}>Save Supplier</button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
};

export default WarehouseDashboard;
